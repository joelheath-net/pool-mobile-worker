{
  "name": "St Paul's League",
  "short_name": "St Paul's",
  "description": "Track upcoming fixtures, past results, and league standings for St Paul's Pool League.",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "display_override": [
    "standalone",
    "window-controls-overlay"
  ],
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#F4F5EF",
  "background_color": "#173A2B",
  "icons": [
    {
      "src": "/images/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/images/icon-96x96-monochrome.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "monochrome"
    },
    {
      "src": "/images/icon-192x192-monochrome.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "monochrome"
    }
  ],
  "screenshots": [
